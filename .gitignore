# ══════════════════════════════════════════════════════════════════
#  Token Gateway workspace — Git 忽略規則
#  原則：只追蹤「原始碼與文件」；建置產物、外部 clone、設計資產歷史版本一律排除。
# ══════════════════════════════════════════════════════════════════

# ── 建置產物（可重建，約 29 GB / 0.43 GB）────────────────────────
/token-gateway/src-tauri/target/
/token-gateway/node_modules/
/token-gateway/dist/
/token-gateway/dist-ssr/
*.tsbuildinfo

# ── 離線快照（避免自我遞迴）─────────────────────────────────────
/_backup/

# ── 外來參考物 ─────────────────────────────────────────────────
# OpenAI Codex 上游原始碼（git clone，自帶 .git，非本專案）
/codex/

# ── 設計資產歷史版本（只保留最終入選版；入選版在 src-tauri/icons/）──
/icon-lab/
/token-gateway/src-tauri/icons/concepts/

# ── 日誌與暫存 ─────────────────────────────────────────────────
*.log
/token-gateway/*.tmp

# ── Python 暫存 ────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Agent 工作區：保留設計記憶，忽略暫存產物 ────────────────────
/.workbuddy/tmp/
